{
  "name": "encorelink",
  "version": "1.0.0",
  "main": "server/server.js",
  "engines": {
    "node": "8.9.4",
    "npm": "5.6.x"
  },
  "scripts": {
    "start-js": "react-scripts start",
    "start": "npm-run-all -p watch-css start-js",
    "build-js": "react-scripts build",
    "build": "npm-run-all build-css build-js && cpy build/index.html build --rename 404.html",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "build-css": "node-sass-chokidar src/ -o src/",
    "watch-css": "npm run build-css && node-sass-chokidar src/ -o src/ --watch --recursive"
  },
  "dependencies": {
    "moment-timezone": "^0.5.14",
    "node-sass-chokidar": "0.0.3",
    "npm-run-all": "^4.1.2",
    "react": "^15.6.1",
    "react-add-to-calendar": "^0.1.5",
    "react-datetime": "^2.12.0",
    "react-dom": "^15.6.1",
    "react-google-autocomplete": "^1.0.15",
    "react-modal": "^3.1.12",
    "react-redux": "^5.0.6",
    "react-router": "^3.2.0",
    "redux": "^3.7.2",
    "redux-form": "^6.8.0",
    "redux-logger": "^2.6.1",
    "redux-persist": "^4.0.0-alpha7",
    "redux-recycle": "^1.2.0",
    "redux-thunk": "^2.1.0"
  },
  "devDependencies": {
    "@kadira/react-storybook-addon-info": "^3.4.0",
    "@kadira/storybook": "^2.35.3",
    "@kadira/storybook-addon-knobs": "^1.7.1",
    "@kadira/storybook-addon-options": "^1.0.2",
    "@kadira/storybook-addons": "^1.6.1",
    "@kadira/storybook-channel": "^1.1.0",
    "cpy-cli": "^1.0.1",
    "react-scripts": "^1.1.0",
    "react-test-renderer": "^15.6.1",
    "storyshots": "^3.2.2"
  },
  "repository": {
    "type": "",
    "url": ""
  },
  "license": "ISC",
  "description": "encorelink"
}
